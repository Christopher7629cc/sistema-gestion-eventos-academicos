digraph UML {
graph [rankdir=LR, splines=polyline, nodesep=.35, ranksep=.85, bgcolor="white", pad=.2, dpi=140];
node [shape=plain, fontname="Helvetica"];
edge [color="#607487",fontname="Helvetica",fontsize=9,arrowsize=.7];
Usuario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- id: int<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- correo: String<BR ALIGN="LEFT"/>- contrasena: String<BR ALIGN="LEFT"/>- rol: String<BR ALIGN="LEFT"/>- activo: boolean<BR ALIGN="LEFT"/>- sesionIniciada: boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ iniciarSesion(correo: String, contrasena: String): boolean<BR ALIGN="LEFT"/>+ cerrarSesion(): void<BR ALIGN="LEFT"/>+ actualizarPerfil(nombre: String, correo: String): void<BR ALIGN="LEFT"/>+ tieneAcceso(): boolean</FONT></TD></TR></TABLE>>];
Participante [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Participante</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- matricula: String<BR ALIGN="LEFT"/>- carrera: String<BR ALIGN="LEFT"/>- telefono: String<BR ALIGN="LEFT"/>- CATALOGO: List&lt;Evento&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ inscribirse(evento: Evento): Inscripcion<BR ALIGN="LEFT"/>+ cancelarInscripcion(inscripcion: Inscripcion): void<BR ALIGN="LEFT"/>+ consultarEventos(): List&lt;Evento&gt;<BR ALIGN="LEFT"/>+ verificarPerfil(): boolean</FONT></TD></TR></TABLE>>];
Organizador [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Organizador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idOrganizador: int<BR ALIGN="LEFT"/>- dependencia: String<BR ALIGN="LEFT"/>- eventos: List&lt;Evento&gt;<BR ALIGN="LEFT"/>- eventoSeleccionado: Evento</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ crearEvento(evento: Evento): void<BR ALIGN="LEFT"/>+ modificarEvento(evento: Evento): void<BR ALIGN="LEFT"/>+ asignarEspacio(espacio: Espacio): void<BR ALIGN="LEFT"/>+ asignarHorario(horario: Horario): void</FONT></TD></TR></TABLE>>];
Evento [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Evento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idEvento: int<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- descripcion: String<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/>- cupoMaximo: int<BR ALIGN="LEFT"/>- estado: String<BR ALIGN="LEFT"/>- espacio: Espacio<BR ALIGN="LEFT"/>- horario: Horario<BR ALIGN="LEFT"/>- categoria: Categoria<BR ALIGN="LEFT"/>- inscripciones: List&lt;Inscripcion&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ validarCupo(): boolean<BR ALIGN="LEFT"/>+ registrarInscripcion(participante: Participante): Inscripcion<BR ALIGN="LEFT"/>+ asignarEspacio(espacio: Espacio): void<BR ALIGN="LEFT"/>+ asignarHorario(horario: Horario): void<BR ALIGN="LEFT"/>+ generarReporte(): Reporte<BR ALIGN="LEFT"/>+ contarConfirmadas(): int</FONT></TD></TR></TABLE>>];
Inscripcion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Inscripcion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idInscripcion: int<BR ALIGN="LEFT"/>- fechaInscripcion: LocalDateTime<BR ALIGN="LEFT"/>- estado: String<BR ALIGN="LEFT"/>- codigoAcceso: String<BR ALIGN="LEFT"/>- participante: Participante<BR ALIGN="LEFT"/>- evento: Evento<BR ALIGN="LEFT"/>- notificaciones: List&lt;Notificacion&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ confirmar(): void<BR ALIGN="LEFT"/>+ cancelar(): void<BR ALIGN="LEFT"/>+ generarNotificacion(): Notificacion</FONT></TD></TR></TABLE>>];
Notificacion [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Notificacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idNotificacion: int<BR ALIGN="LEFT"/>- mensaje: String<BR ALIGN="LEFT"/>- fechaEnvio: LocalDateTime<BR ALIGN="LEFT"/>- leida: boolean<BR ALIGN="LEFT"/>- tipo: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ enviar(): void<BR ALIGN="LEFT"/>+ marcarComoLeida(): void<BR ALIGN="LEFT"/>+ generarAlertaEventoProximo(evento: Evento): void</FONT></TD></TR></TABLE>>];
Horario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Horario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idHorario: int<BR ALIGN="LEFT"/>- fecha: LocalDate<BR ALIGN="LEFT"/>- horaInicio: LocalTime<BR ALIGN="LEFT"/>- horaFin: LocalTime<BR ALIGN="LEFT"/>- evento: Evento</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ validarDisponibilidad(): boolean<BR ALIGN="LEFT"/>+ asignarEvento(evento: Evento): void<BR ALIGN="LEFT"/>+ modificarHorario(inicio: LocalTime, fin: LocalTime): void</FONT></TD></TR></TABLE>>];
Espacio [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Espacio</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idEspacio: int<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- ubicacion: String<BR ALIGN="LEFT"/>- capacidad: int<BR ALIGN="LEFT"/>- disponible: boolean<BR ALIGN="LEFT"/>- bloqueoManual: boolean<BR ALIGN="LEFT"/>- reservas: Map&lt;Evento, Horario&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ validarDisponibilidad(): boolean<BR ALIGN="LEFT"/>+ reservar(): void<BR ALIGN="LEFT"/>+ liberar(): void<BR ALIGN="LEFT"/>+ tieneCapacidad(cupoRequerido: int): boolean<BR ALIGN="LEFT"/>+ validarDisponibilidad(horario: Horario, excepto: Evento): boolean</FONT></TD></TR></TABLE>>];
Categoria [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Categoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idCategoria: int<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- descripcion: String<BR ALIGN="LEFT"/>- eventos: List&lt;Evento&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ clasificarEvento(evento: Evento): void<BR ALIGN="LEFT"/>+ obtenerEventos(): List&lt;Evento&gt;</FONT></TD></TR></TABLE>>];
Reporte [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#8296A8" BGCOLOR="#F4F7FA"><TR><TD BGCOLOR="#2C4663" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Reporte</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">- idReporte: int<BR ALIGN="LEFT"/>- fechaGeneracion: LocalDateTime<BR ALIGN="LEFT"/>- tipo: String<BR ALIGN="LEFT"/>- contenido: String<BR ALIGN="LEFT"/>- evento: Evento<BR ALIGN="LEFT"/>- asistentesRegistrados: Set&lt;Integer&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">+ generarReporteAsistencia(evento: Evento): String<BR ALIGN="LEFT"/>+ calcularPorcentajeAsistencia(): double<BR ALIGN="LEFT"/>+ registrarAsistencia(participante: Participante): void<BR ALIGN="LEFT"/>+ exportar(): void</FONT></TD></TR></TABLE>>];
Participante -> Usuario [arrowhead=empty, label="hereda", color="#4D6479"];
Organizador -> Usuario [arrowhead=empty, label="hereda", color="#4D6479"];
Organizador -> Evento [label="1 administra 0..*"];
Participante -> Inscripcion [label="1 realiza 0..*"];
Evento -> Inscripcion [label="1 registra 0..*"];
Inscripcion -> Notificacion [label="1 genera 0..*"];
Evento -> Horario [label="1 asigna 1"];
Evento -> Espacio [label="0..* utiliza 1"];
Evento -> Categoria [label="0..* pertenece a 1"];
Evento -> Reporte [label="1 genera 0..*"];
}